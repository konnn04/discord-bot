generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id        String          @id
  name      String
  icon      String?
  ownerId   String
  settings  Json?
  joinedAt  DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  members   GuildMember[]
  xpHistory GuildMemberXp[]
}

model GlobalSetting {
  id        String   @id @default("global")
  settings  Json?
  updatedAt DateTime @updatedAt
}

model User {
  id           String          @id @default(cuid())
  avatar       String?
  createdAt    DateTime        @default(now())
  discordId    String          @unique
  updatedAt    DateTime        @updatedAt
  username     String
  guildMembers GuildMember[]
  xpHistory    GuildMemberXp[]
}

model GuildMember {
  id                String   @id @default(cuid())
  userId            String
  guildId           String
  xp                Int      @default(0)
  level             Int      @default(0)
  totalVoiceMinutes Int      @default(0)
  meetingsAttended  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([guildId])
  @@index([guildId, xp(sort: Desc)])
}

model GuildMemberXp {
  id        String   @id @default(cuid())
  userId    String
  guildId   String
  period    String
  xp        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId, period])
  @@index([guildId, period, xp(sort: Desc)])
}

model PublicPresence {
  id               String   @id @default(cuid())
  discordId        String   @unique
  guildId          String
  enabled          Boolean  @default(true)
  showcaseGuildIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([discordId])
}

model GiftcodeCache {
  game  String @id
  hash  String
  codes Json
}
