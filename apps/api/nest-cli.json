{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "apps/api/src/main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "modules/discord/chatbot/prompts/**/*.md", "outDir": "dist" }
    ],
    "watchAssets": true
  }
}
