{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "FoxyBot - Discord bot with web dashboard",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev-b": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm build --watch\"",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter shared build && pnpm --filter api build && pnpm --filter web build",
    "build:shared": "pnpm --filter shared build",
    "start": "pnpm --filter api start",
    "start:prod": "pnpm --filter api start:prod",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:studio": "pnpm --filter api exec prisma studio"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.11",
      "fast-uri": "3.1.2",
      "hono": "4.12.18",
      "@hono/node-server": "1.19.13"
    }
  },
  "keywords": [],
  "author": "Konnn04",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}