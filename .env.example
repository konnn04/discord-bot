# ============================================================
# FoxyBot — single source of truth for env (monorepo root)
# Copy to .env and fill in. Loaded by the API, Prisma CLI, and Vite.
# NOTE: only variables prefixed with VITE_ are exposed to the web client;
#       everything else stays server-side.
# ============================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app"

# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret

# Server
PORT=3000
HOST=0.0.0.0

# Auth
JWT_SECRET=your_jwt_secret_here

# Super Admins (comma-separated Discord user IDs)
SUPER_ADMIN=732157441889927239,605703751327678486

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Music Server
MUSIC_SERVER_URL="https://xxxxxx.up.railway.app/api/v1"
MUSIC_SERVER_API_TOKEN="sk_xxxxxxxxxxxxxxxxxxxxxxxx"

# Spotify (for user-specific music features)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

CUSTOM_DOMAIN=
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=
DASHBOARD_URL=

REGISTER_SLASH=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CHATBOT_PROMPTS_DIR=

# VITE_API_BASE=/api
