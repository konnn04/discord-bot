# Discord
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret

# Server
PORT=3000
HOST=0.0.0.0
APP_URL="http://localhost:3000"
JWT_SECRET=your_random_secret

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/botdb
NODE_ENV=development

# Spotify
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# YouTube (Optional - for RiknClient)
YOUTUBE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
YOUTUBE_BIN_DIR=
YOUTUBE_COOKIES_PATH=

# YouTube Music (Optional)
YOUTUBE_MUSIC_USER_AGENT="Mozilla/5.0..."
YOUTUBE_MUSIC_COOKIES_PATH=
YOUTUBE_MUSIC_GL=US
YOUTUBE_MUSIC_HL=en


DEVELOPER_ID=["7321xxxxxxxxxxxx"]